{
  "name": "bubble-wrap",
  "private": true,
  "version": "0.1.0",
  "description": "A whole sheet of tiny, satisfying bubble wrap pops.",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --outDir docs/play",
    "lint": "oxlint",
    "preview": "vite preview",
    "start": "npm run build && electron .",
    "dist:mac": "vite build && electron-builder --mac",
    "dist:win": "vite build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^41.7.1",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.89.0",
    "vite": "^8.3.5"
  },
  "build": {
    "appId": "com.bubblewrap.app",
    "productName": "Bubble Wrap",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.entertainment",
      "icon": "build/icon.icns",
      "artifactName": "Bubble-Wrap-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "dir",
          "arch": ["x64"]
        }
      ]
    },
    "dmg": {
      "title": "Bubble Wrap ${version}",
      "artifactName": "Bubble-Wrap-mac-${arch}.${ext}"
    },
    "win": {
      "icon": "build/icon-1024.png",
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Bubble-Wrap-win-setup.${ext}"
    }
  }
}
